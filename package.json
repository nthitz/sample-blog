{
  "name": "browser-rum-research",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev:static": "npm run dev --workspace @rum/static",
    "dev:react": "npm run dev --workspace @rum/react",
    "build": "npm run build --workspaces --if-present",
    "serve:static": "npm run serve --workspace @rum/static",
    "serve:react": "npm run serve --workspace @rum/react",
    "check": "node --test scripts/check.test.ts",
    "dev:api": "npm run dev --workspace @rum/api",
    "serve:api": "npm run serve --workspace @rum/api",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
